# -----------------------------------------------------------------------------
# Frontend environment variables — COPY TO frontend/.env AND FILL IN
#   cp .env.example .env
# frontend/.env is git-ignored. NEVER commit real credentials.
# -----------------------------------------------------------------------------

# Base URL of the Express backend, including the /api prefix.
# Use a full URL in development because the frontend and API run on different
# ports. In production, where both are served from the same host, "/api" works.
VITE_API_BASE_URL=http://localhost:5000/api

# WhatsApp number in international format, digits only (no +, no spaces).
VITE_WHATSAPP_NUMBER=923499995484

# -----------------------------------------------------------------------------
# Admin authentication is handled by the backend (JWT + bcrypt).
# There is deliberately no VITE_ADMIN_* variable here: anything prefixed with
# VITE_ is compiled into the public JavaScript bundle and would be readable by
# anyone who inspects the shipped site. Credentials live only in backend/.env.
# -----------------------------------------------------------------------------